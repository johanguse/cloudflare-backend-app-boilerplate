# Copy to `.dev.vars` for `bun run dev` (never commit `.dev.vars`).
# If `BETTER_AUTH_SECRET` is unset and `ENVIRONMENT` is local/development, a dev-only default is used (`src/lib/config.ts`).
# BETTER_AUTH_SECRET=
# RESEND_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# Optional: public base URL for R2 (custom domain / CDN). When set, upload responses and GET /uploads/:key/url use direct public URLs.
# R2_PUBLIC_BASE_URL=
# OPENROUTER_KEY=
#
# The following are only needed for running `drizzle-kit` against a remote D1 database.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_D1_DATABASE_ID=
# DRIZZLE_D1_REMOTE=true
#
# `RESEND_FROM_EMAIL` is set in `wrangler.jsonc` → `vars`; change there or per-environment blocks.
