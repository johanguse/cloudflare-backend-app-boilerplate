{
	"name": "cloudflare-backend-app-boilerplate",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev --local",
		"cf:typegen": "wrangler types",
		"cf:deploy": "wrangler deploy",
		"cf:deploy:staging": "wrangler deploy --env staging",
		"cf:check": "bun run type-check && wrangler deploy --dry-run",
		"build": "wrangler build",
		"check": "biome check --write src test scripts --verbose",
		"type-check": "tsc --noEmit",
		"test": "vitest",
		"test:run": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
		"db:migrate:prod": "wrangler d1 migrations apply DB --remote",
		"db:studio": "drizzle-kit studio",
		"db:seed:local": "wrangler d1 execute DB --local --file=./scripts/seed-local.sql"
	},
	"dependencies": {
		"better-auth": "^1.6.10",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.14",
		"jose": "^6.2.3",
		"resend": "^6.12.3",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.6",
		"@cloudflare/workers-types": "^4.20250510.0",
		"@cloudflare/vitest-pool-workers": "^0.12.21",
		"drizzle-kit": "^0.31.10",
		"typescript": "5.8.3",
		"vitest": "~3.2.4",
		"wrangler": "^4.84.1"
	},
	"packageManager": "bun@1.2.17",
	"patchedDependencies": {
		"better-call@1.3.5": "patches/better-call@1.3.5.patch"
	}
}
