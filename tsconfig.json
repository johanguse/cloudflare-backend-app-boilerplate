{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"paths": {
			"@/*": ["./src/*"]
		},
		"types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers"]
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.d.ts", "scripts/**/*.ts", "worker-configuration.d.ts"]
}
