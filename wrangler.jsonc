{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-boilerplate-backend",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-01",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"triggers": {
		"crons": ["0 6 * * *"]
	},
	"vars": {
		"ENVIRONMENT": "local",
		"APP_NAME": "CF Boilerplate Backend",
		"BETTER_AUTH_URL": "http://localhost:8787",
		"TRUSTED_ORIGINS": "http://localhost:8081,http://127.0.0.1:8081,http://192.168.100.124:8081,http://192.168.100.124:8787",
		// Domain must be onboarded: `wrangler email sending enable <domain>`.
		"FROM_EMAIL": "noreply@guseapp.com",
		// Any Workers AI text-generation model that takes a `messages` array.
		"AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
	},
	"ai": { "binding": "AI" },
	// `remote: true` proxies local sends to the real service; without it workerd
	// simulates them and nothing is delivered. Local dev logs instead of sending
	// unless EMAIL_DEV_DELIVERY=true — see `src/lib/email.ts`.
	"send_email": [{ "name": "EMAIL", "remote": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cf-boilerplate-backend-db",
			"database_id": "00000000-0000-0000-0000-000000000001",
			"migrations_dir": "src/db/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION_KV",
			"id": "00000000000000000000000000000001"
		},
		{
			"binding": "CACHE_KV",
			"id": "00000000000000000000000000000002"
		}
	],
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "cf-boilerplate-backend-storage"
		}
	],
	"env": {
		"staging": {
			"name": "cf-boilerplate-backend-staging",
			"vars": {
				"ENVIRONMENT": "staging",
				"APP_NAME": "CF Boilerplate Backend (Staging)",
				"BETTER_AUTH_URL": "https://api-staging.example.com",
				"TRUSTED_ORIGINS": "https://api-staging.example.com",
				"FROM_EMAIL": "noreply@example.com",
				"AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
			},
			"ai": { "binding": "AI" },
			"send_email": [{ "name": "EMAIL" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "cf-boilerplate-backend-db-staging",
					"database_id": "00000000-0000-0000-0000-000000000002",
					"migrations_dir": "src/db/migrations"
				}
			],
			"kv_namespaces": [
				{ "binding": "SESSION_KV", "id": "REPLACE_STAGING_SESSION_KV_ID" },
				{ "binding": "CACHE_KV", "id": "REPLACE_STAGING_CACHE_KV_ID" }
			],
			"r2_buckets": [{ "binding": "STORAGE", "bucket_name": "cf-boilerplate-backend-storage-staging" }]
		},
		"production": {
			"name": "cf-boilerplate-backend-production",
			"vars": {
				"ENVIRONMENT": "production",
				"APP_NAME": "CF Boilerplate Backend",
				"BETTER_AUTH_URL": "https://api.example.com",
				"TRUSTED_ORIGINS": "https://api.example.com",
				"FROM_EMAIL": "noreply@example.com",
				"AI_MODEL": "@cf/meta/llama-3.1-8b-instruct"
			},
			"ai": { "binding": "AI" },
			"send_email": [{ "name": "EMAIL" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "cf-boilerplate-backend-db-prod",
					"database_id": "00000000-0000-0000-0000-000000000003",
					"migrations_dir": "src/db/migrations"
				}
			],
			"kv_namespaces": [
				{ "binding": "SESSION_KV", "id": "REPLACE_PROD_SESSION_KV_ID" },
				{ "binding": "CACHE_KV", "id": "REPLACE_PROD_CACHE_KV_ID" }
			],
			"r2_buckets": [{ "binding": "STORAGE", "bucket_name": "cf-boilerplate-backend-storage-prod" }]
		}
	}
}
